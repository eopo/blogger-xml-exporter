{
  "name": "blogger-xml-exporter-frontend",
  "version": "0.4.2",
  "type": "module",
  "description": "Vue 3 frontend for Blogger XML Exporter",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --ext .vue,.js,.ts,.mjs",
    "lint:fix": "eslint . --ext .vue,.js,.ts,.mjs --fix",
    "format": "prettier --write 'src/**/*.{vue,js,ts,json,css}'",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage"
  },
  "dependencies": {
    "flatpickr": "^4.6.13",
    "vue": "3.5.45",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/forms": "0.5.11",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/flatpickr": "^3.0.2",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitest/coverage-v8": "5.1.0",
    "@vitest/ui": "5.1.0",
    "@vue/test-utils": "2.5.1",
    "autoprefixer": "10.6.2",
    "eslint": "10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "10.12.0",
    "globals": "^17.7.0",
    "jsdom": "^30.0.0",
    "postcss": "8.5.32",
    "prettier": "^3.9.5",
    "tailwindcss": "4.3.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "vue-eslint-parser": "^10.3.0",
    "vue-tsc": "3.3.14"
  }
}
